# Keep Vercel upload context minimal for faster and more reliable deploys.
.git
.git/**
node_modules
node_modules/**
.pnpm-store
.pnpm-store/**

# Local configuration and maintainer records are never deployment inputs.
.env
.env.*
*.md
deployment
deployment/**

# Rust contract build artifacts (not needed for frontend deploy).
backend/contracts-rust/target
backend/contracts-rust/target/**

# Local caches and editor/runtime artifacts.
.vite
.vite/**
.DS_Store
*.log
